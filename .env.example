# Live Stats Source (GitHub Gist raw URL)
# The site fetches stats during the build phase from this URL.
# Falls back to default values if not set.
GIST_STATS_URL=https://gist.githubusercontent.com/USERNAME/GIST_ID/raw/stats.json

# StaticForms API Key (Contact form backend)
# Required for the contact form to function. Get your key at https://www.staticforms.xyz
# The form will silently fail to submit if this is missing.
PUBLIC_STATICFORMS_KEY=your-staticforms-key-here
