---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import AmbientBackground from '../components/AmbientBackground';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.links.dashboard} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/ppic.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteConfig.links.dashboard} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/assets/ppic.png" />
    
    <!-- Fonts -->
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@200,300,400,500,600,700&f[]=satoshi@300,400,500,700,900&display=swap" rel="stylesheet">
  </head>
  <body class="antialiased selection:bg-[#c92085] selection:text-white bg-bg-main">
    <div class="custom-cursor hidden md:block"></div>
    <AmbientBackground client:only="react" />
    <slot />

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      // Register GSAP ScrollTrigger
      gsap.registerPlugin(ScrollTrigger);

      // Initialize Lenis with smooth momentum physics
      const lenis = new Lenis({
        duration: 1.4,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        direction: 'vertical',
        gestureDirection: 'vertical',
        smooth: true,
      });

      // Synchronize Lenis with ScrollTrigger
      lenis.on('scroll', ScrollTrigger.update);

      // Refresh ScrollTrigger after all resources (images, fonts, iframes) are fully loaded
      window.addEventListener('load', () => {
        setTimeout(() => {
          ScrollTrigger.refresh();
        }, 100);
      });

      // Global safety fallback for GSAP + ScrollTrigger FOUC/Stuck issues
      // If a user reloads the page 2-3 times rapidly, ScrollTrigger can misfire and leave 
      // elements stuck with inline opacity: 0 from gsap.from() calls.
      setTimeout(() => {
        const animatedElements = document.querySelectorAll(
          '.snap-center, .tech-card, .about-intro-card, .about-reveal, .about-accent-bar, #contact .text-center > *, #contact .glass-card, #home-left-card .animate-in, #home img'
        );
        animatedElements.forEach((el) => {
          const htmlEl = el as HTMLElement;
          if (htmlEl.style.opacity === '0' || window.getComputedStyle(htmlEl).opacity === '0') {
            gsap.set(htmlEl, { clearProps: "all" });
            htmlEl.style.opacity = '1';
            htmlEl.style.visibility = 'visible';
          }
        });
      }, 3000);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // Custom Cursor with elegant lag tracking
      const cursor = document.querySelector('.custom-cursor');
      if (cursor) {
        document.addEventListener('mousemove', (e) => {
          gsap.to(cursor, {
            x: e.clientX,
            y: e.clientY,
            duration: 0.15,
            ease: 'power2.out',
            overwrite: 'auto'
          });
        });

        // Dynamic Hover effect
        const onEnter = () => cursor.classList.add('hovered');
        const onLeave = () => cursor.classList.remove('hovered');

        const updateHoverables = () => {
          document.querySelectorAll('a, button, [role="button"], .magnetic-btn, .glass-card').forEach((el) => {
            el.removeEventListener('mouseenter', onEnter);
            el.removeEventListener('mouseleave', onLeave);
            el.addEventListener('mouseenter', onEnter);
            el.addEventListener('mouseleave', onLeave);
          });
        };

        updateHoverables();

        // Re-observe if the DOM updates dynamically
        const observer = new MutationObserver(updateHoverables);
        observer.observe(document.body, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>
