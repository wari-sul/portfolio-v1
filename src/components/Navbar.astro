---
import { siteConfig } from '../config/site';
---

<nav class="text-gray-200 flex justify-between items-center max-w-[1240px] mx-auto h-24 px-4 text-l z-50 relative">
  <h1 class="text-3xl font-bold ml-4"><a href="#home">{siteConfig.name}</a></h1>
  
  <ul class="hidden md:flex z-50">
    <li class="p-5"><a href="#portfolio" class="hover:text-gray-400 transition">Portfolio</a></li>
    <li class="p-5"><a href="#about" class="hover:text-gray-400 transition">Skills & Experiences</a></li>
    <li class="p-5">
      <a href="#contact" class="font-bold px-4 py-2 rounded-xl bg-primary-color hover:opacity-90 transition">Contact</a>
    </li>
    <li class="p-5">
      <a href={siteConfig.links.dashboard} target="_blank" rel="noopener noreferrer" class="hover:text-gray-400 transition">Blog</a>
    </li>
  </ul>

  <!-- Mobile Menu Button -->
  <button id="mobile-menu-btn" class="z-[100] block md:hidden text-4xl mr-4" aria-label="Toggle Menu">
    <svg id="menu-icon" class="w-8 h-8 text-[#202121] fill-current bg-gradient-to-r from-red-500 via-orange-500 to-purple-600 rounded" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="fixed left-[-100%] top-0 h-full w-[60%] border-r border-r-gray-900 bg-[#202121] ease-in-out duration-500 z-50">
    <h1 class="text-3xl primary-color-text m-4 font-bold">{siteConfig.name}</h1>
    <ul class="p-8 text-2xl">
      <li class="p-2"><a href="#portfolio" class="mobile-link block hover:text-gray-400 transition">Portfolio</a></li>
      <li class="p-2"><a href="#about" class="mobile-link block hover:text-gray-400 transition">Skills & Experiences</a></li>
      <li class="p-2"><a href="#contact" class="mobile-link block hover:text-gray-400 transition">Contact</a></li>
      <li class="p-2"><a href={siteConfig.links.dashboard} target="_blank" rel="noopener noreferrer" class="block hover:text-gray-400 transition">Blog</a></li>
    </ul>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');
  let navOpen = false;

  const toggleMenu = () => {
    navOpen = !navOpen;
    if (navOpen) {
      menu?.classList.remove('left-[-100%]');
      menu?.classList.add('left-0');
      btn?.classList.add('fixed', 'right-4', 'top-7');
      btn?.classList.remove('relative', 'mr-4');
    } else {
      menu?.classList.add('left-[-100%]');
      menu?.classList.remove('left-0');
      btn?.classList.remove('fixed', 'right-4', 'top-7');
      btn?.classList.add('relative', 'mr-4');
    }
  };

  btn?.addEventListener('click', toggleMenu);
  links.forEach(link => link.addEventListener('click', () => {
    if (navOpen) toggleMenu();
  }));
</script>
