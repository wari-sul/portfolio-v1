---
import { siteConfig } from '../config/site';
---

<nav class="fixed top-6 left-1/2 -translate-x-1/2 w-[92%] max-w-[1200px] h-16 glass z-[9999] px-6 flex justify-between items-center text-gray-200 transition-all duration-300">
  <h1 class="text-2xl font-black tracking-tight font-display"><a href="#home" class="hover:opacity-90 transition">{siteConfig.name}</a></h1>
  
  <ul class="hidden md:flex items-center gap-1">
    <li><a href="#portfolio" class="px-4 py-2 hover:text-white transition font-sans text-sm tracking-wide">Portfolio</a></li>
    <li><a href="#about" class="px-4 py-2 hover:text-white transition font-sans text-sm tracking-wide">Skills & Experience</a></li>
    <li><a href="https://blog.warisul.com/" target="_blank" rel="noopener noreferrer" class="px-4 py-2 hover:text-white transition font-sans text-sm tracking-wide">Blog</a></li>
    <li class="ml-2">
      <a href="#contact" class="font-extrabold px-5 py-2.5 rounded-full bg-primary-color hover:opacity-90 transition text-sm tracking-wide">Contact</a>
    </li>
  </ul>

  <!-- Mobile Menu Button -->
  <button id="mobile-menu-btn" class="z-[100] block md:hidden text-3xl" aria-label="Toggle Menu">
    <svg id="menu-icon" class="w-7 h-7 text-[#202121] fill-current bg-gradient-to-r from-red-500 via-orange-500 to-purple-600 rounded p-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="fixed left-[-100%] top-0 h-screen w-[70%] border-r border-r-gray-900 bg-[#0a0a0c]/95 backdrop-blur-xl ease-in-out duration-500 z-50 flex flex-col justify-center">
    <h1 class="text-3xl primary-color-text m-6 font-bold font-display text-center">{siteConfig.name}</h1>
    <ul class="p-8 text-2xl space-y-6 text-center font-sans">
      <li><a href="#portfolio" class="mobile-link block hover:text-white transition">Portfolio</a></li>
      <li><a href="#about" class="mobile-link block hover:text-white transition">Skills & Experience</a></li>
      <li><a href="#contact" class="mobile-link block hover:text-white transition">Contact</a></li>
      <li><a href="https://blog.warisul.com/" target="_blank" rel="noopener noreferrer" class="block hover:text-white transition">Blog</a></li>
    </ul>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');
  let navOpen = false;

  const toggleMenu = () => {
    navOpen = !navOpen;
    if (navOpen) {
      menu?.classList.remove('left-[-100%]');
      menu?.classList.add('left-0');
      btn?.classList.add('fixed', 'right-4', 'top-7');
      btn?.classList.remove('relative', 'mr-4');
    } else {
      menu?.classList.add('left-[-100%]');
      menu?.classList.remove('left-0');
      btn?.classList.remove('fixed', 'right-4', 'top-7');
      btn?.classList.add('relative', 'mr-4');
    }
  };

  btn?.addEventListener('click', toggleMenu);
  links.forEach(link => link.addEventListener('click', () => {
    if (navOpen) toggleMenu();
  }));
</script>
