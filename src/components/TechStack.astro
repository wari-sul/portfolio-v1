---
import TechStackGrid from './TechStackGrid';
---

<section class="mt-32 max-w-[1200px] mx-auto px-4 md:px-6 py-12 md:py-16 scroll-mt-24" id="tech-stack">
  <div class="mb-16 text-center">
    <h2 class="text-5xl md:text-6xl font-bold tracking-tight font-display mb-6">
      My <span class="primary-color-text">Tech Stack</span>
    </h2>
    <p class="text-gray-400 font-sans text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
      A curated landscape of my technical expertise, spanning deep artificial intelligence, high-scale cloud platforms, and modern web architecture.
    </p>
  </div>

  {/* React Island hydrates when scrolled into view */}
  <TechStackGrid client:visible />
</section>

<!-- GSAP/VanillaTilt animations are now handled inside TechStackGrid.tsx useEffect
     to ensure they run AFTER the React island hydrates and .tech-card elements exist in DOM -->
