---
import { siteConfig } from '../config/site';
import { Image } from 'astro:assets';
import profilePic from '../assets/ppic.png';
import profilePicMobile from '../assets/ppic-mobile.png';
import { fetchStats } from '../utils/fetchStats';

const stats = await fetchStats();
---

<div class="max-w-[1200px] mx-auto grid md:grid-cols-8 gap-8 p-6 md:p-0 md:py-32" id="home">
  
  <div class="grid grid-cols-1 md:grid-cols-2 md:col-span-5 glass-card p-10 relative" id="home-left-card">
    <!-- Mobile Profile Picture -->
    <div class="block md:hidden mb-8">
      <Image
        class="w-full max-w-[300px] mx-auto h-auto rounded-full"
        src={profilePicMobile}
        alt="Profile picture"
        width={300}
        height={300}
        loading="eager"
      />
    </div>

  <!-- Desktop Profile Picture - isolated from cursor blend mode -->
    <div class="hidden md:block my-auto relative group" style="isolation: isolate;">
      <div class="relative">
        <Image
          class="w-[420px] h-[520px] mx-auto object-cover object-top rounded-2xl transition-all duration-500 ease-in-out hover:scale-[1.02]"
          src={profilePic}
          alt="Profile picture"
          width={840}
          height={1040}
          loading="eager"
          quality={80}
          format={'avif'}
        />
      </div>
    </div>
  
    <div class="my-auto ml-6 flex flex-col depth-md min-w-0">
      <p class="animate-in text-xl md:text-2xl font-extrabold text-gray-200 font-display tracking-tight leading-none">
        Hi! I am
      </p>
      <span class="animate-in text-3xl md:text-4xl lg:text-5xl block my-2 text-white font-extrabold font-display leading-tight break-words">{siteConfig.name}</span>
      <span class="animate-in block min-h-[3.5rem] mt-1 overflow-hidden">
        <span id="typing-text" class="inline text-lg md:text-xl leading-normal py-1 primary-color-text font-bold relative"></span>
      </span>

      <p class="animate-in text-lg md:text-xl font-medium text-gray-400 font-sans tracking-wide mt-4">
        with <span class="text-white font-bold">{stats.experience} years</span> of elite industry experience
      </p>
      
      <div class="animate-in mt-6 flex gap-3 items-center">
        <a href={siteConfig.links.github} target="_blank" rel="noopener noreferrer" class="magnetic-btn text-gray-400 hover:text-white transition-all duration-200 ease-out inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 hover:border-white/30 hover:bg-white/5" aria-label="GitHub">
          <svg fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
        </a>
        <a href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer" class="magnetic-btn text-gray-400 hover:text-white transition-all duration-200 ease-out inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 hover:border-white/30 hover:bg-white/5" aria-label="LinkedIn">
          <svg fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
        <a href={siteConfig.links.hashnode} target="_blank" rel="noopener noreferrer" class="magnetic-btn text-gray-400 hover:text-white transition-all duration-200 ease-out inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 hover:border-white/30 hover:bg-white/5" aria-label="Hashnode">
          <svg fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M22.351 8.019l-6.37-6.37a5.63 5.63 0 0 0-7.962 0l-6.37 6.37a5.63 5.63 0 0 0 0 7.962l6.37 6.37a5.63 5.63 0 0 0 7.962 0l6.37-6.37a5.63 5.63 0 0 0 0-7.962zM12 15.953a3.953 3.953 0 1 1 0-7.906 3.953 3.953 0 0 1 0 7.906z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:col-span-3 gap-6">       
    <div class="p-8 sm:p-12 glass-card flex flex-col justify-center items-center">
      <p class="text-gray-200 text-2xl font-bold mb-8 text-center font-display depth-md">Key Stats</p>
      <div class="flex flex-col gap-6 w-full max-w-[240px] depth-sm">
        <div class="bg-[#333333]/40 border border-white/5 backdrop-blur-md p-5 rounded-xl text-center group hover:border-[#e53e9a]/20 transition-all duration-300">
          <h3 class="text-3xl md:text-4xl font-extrabold text-white font-display primary-color-text leading-none">{stats.projects}</h3>
          <p class="text-gray-400 text-sm font-sans tracking-wide mt-2">Projects Completed</p>
        </div>
        <div class="bg-[#333333]/40 border border-white/5 backdrop-blur-md p-5 rounded-xl text-center group hover:border-[#e53e9a]/20 transition-all duration-300">
          <h3 class="text-3xl md:text-4xl font-extrabold text-white font-display primary-color-text leading-none">{stats.experience}</h3>
          <p class="text-gray-400 text-sm font-sans tracking-wide mt-2">Years Experience</p>
        </div>
        <div class="bg-[#333333]/40 border border-white/5 backdrop-blur-md p-5 rounded-xl text-center group hover:border-[#e53e9a]/20 transition-all duration-300">
          <h3 class="text-3xl md:text-4xl font-extrabold text-white font-display primary-color-text leading-none">{stats.clients}</h3>
          <p class="text-gray-400 text-sm font-sans tracking-wide mt-2">Happy Clients</p>
        </div>
      </div>          
    </div>
  </div>

</div>

<script define:vars={{ titles: siteConfig.jobTitles }}>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const textElement = document.getElementById('typing-text');
    if (textElement) textElement.textContent = titles[0];
  } else {
  const textElement = document.getElementById('typing-text');
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function type() {
    if (!textElement) return;
    const currentWord = titles[wordIndex];
    
    if (isDeleting) {
      textElement.textContent = currentWord.substring(0, charIndex - 1);
      charIndex--;
    } else {
      textElement.textContent = currentWord.substring(0, charIndex + 1);
      charIndex++;
    }

    let typeSpeed = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentWord.length) {
      typeSpeed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      wordIndex = (wordIndex + 1) % titles.length;
      typeSpeed = 400;
    }

    setTimeout(type, typeSpeed);
  }

  setTimeout(type, 1000);
  }

  // Magnetic Button Effect
  const magnets = document.querySelectorAll('.magnetic-btn');
  
  magnets.forEach((btn) => {
    btn.addEventListener('mousemove', (e) => {
      const position = btn.getBoundingClientRect();
      const x = e.clientX - position.left - position.width / 2;
      const y = e.clientY - position.top - position.height / 2;
      
      btn.style.transform = `translate(${x * 0.3}px, ${y * 0.5}px)`;
    });
    
    btn.addEventListener('mouseout', (e) => {
      btn.style.transform = 'translate(0px, 0px)';
    });
  });
</script>

<script>
  import { gsap } from "gsap";
  import VanillaTilt from 'vanilla-tilt';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
  // Initialize smooth 3D tilt for hero cards
  const heroCards = document.querySelectorAll('#home .glass-card');
  VanillaTilt.init(Array.from(heroCards) as HTMLElement[], {
    max: 8,
    speed: 800,
    glare: true,
    "max-glare": 0.12,
    perspective: 1200,
    scale: 1.01,
  });
  }
  
  // Only animate the LEFT card's text children — NOT the Key Stats panel
  if (!prefersReducedMotion) {
  gsap.from("#home-left-card .animate-in", {
    z: -100,
    rotationX: 15,
    y: 50,
    opacity: 0,
    filter: "blur(15px)",
    duration: 1.8,
    stagger: 0.25,
    ease: "power4.out",
    delay: 0.3
  });

  gsap.from("#home img", {
    scale: 0.85,
    y: 30,
    opacity: 0,
    duration: 1.8,
    ease: "power4.out",
    delay: 0.1
  });
  }
</script>
