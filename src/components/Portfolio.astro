---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<div class="max-w-[1200px] mx-auto p-6 md:my-20" id="portfolio">
  <div class="pb-8">
    <h2 class="text-5xl md:text-6xl font-bold font-display text-gray-200 mb-4 tracking-tight">
      My <span class="primary-color-text">Portfolio</span>
    </h2>
    <p class="text-gray-400 font-sans text-lg">Check out some of my recent elite works</p>
  </div>

  <div class="relative w-full group">
    <!-- Horizontal scroll container -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 hide-scrollbar" id="portfolio-container">
      {projects.map(project => (
        <div class="snap-center shrink-0 w-[85%] md:w-[55%] lg:w-[45%] glass-card overflow-hidden group relative flex flex-col h-full border border-white/5 hover:border-[rgba(201,32,133,0.3)] transition-all duration-500">
          <div class="aspect-[16/10] w-full overflow-hidden bg-[#0a0a0c] relative">
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0c] via-transparent to-transparent z-10 opacity-90 group-hover:opacity-50 transition-opacity duration-500 pointer-events-none"></div>
            {project.data.videoUrl ? (
              <iframe
                src={project.data.videoUrl}
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
                class="w-full h-full object-cover relative z-0"
                title={project.data.title}
              ></iframe>
            ) : project.data.image ? (
              <Image
                src={project.data.image}
                alt={project.data.title}
                class="w-full h-full object-cover scale-100 group-hover:scale-110 transition-transform duration-700 ease-out relative z-0"
                loading="lazy"
                width={800}
                quality="mid"
              />
            ) : null}
          </div>
          <div class="p-6 md:p-8 flex-grow flex flex-col relative z-20 -mt-12 bg-gradient-to-t from-[rgba(15,15,18,0.95)] via-[rgba(15,15,18,0.9)] to-transparent">
            <h3 class="text-2xl font-bold text-white mb-3 tracking-wide font-display depth-md">{project.data.title}</h3>
            <p class="text-gray-400 mb-8 min-h-[3.5rem] leading-relaxed text-sm md:text-base flex-grow font-sans depth-sm">{project.data.description}</p>
            <div class="flex justify-between items-center mt-auto pt-4 border-t border-white/10 depth-sm">
              {project.data.links.site && (
                <a href={project.data.links.site} target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 border border-white/10 text-white px-6 py-2.5 rounded-full font-medium text-sm transition-all duration-300 hover:shadow-[0_0_15px_rgba(255,255,255,0.1)]">
                  Live Demo
                </a>
              )}
              {project.data.links.github && (
                <a href={project.data.links.github} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white hover:rotate-12 transition-all duration-300" aria-label="GitHub Repository">
                  <svg fill="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Optional Custom Scroll Indicators -->
    <div class="hidden md:flex justify-between absolute top-1/2 -translate-y-1/2 w-full px-2 pointer-events-none opacity-0 group-hover:opacity-100 transition duration-300 -mx-4">
      <button id="scroll-left" class="pointer-events-auto bg-black/70 text-white p-3 rounded-full hover:bg-black transition" aria-label="Scroll left">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <button id="scroll-right" class="pointer-events-auto bg-black/70 text-white p-3 rounded-full hover:bg-black transition" aria-label="Scroll right">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* Hide standard scrollbar for a cleaner look */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const container = document.getElementById('portfolio-container');
  const scrollLeftBtn = document.getElementById('scroll-left');
  const scrollRightBtn = document.getElementById('scroll-right');

  if (container && scrollLeftBtn && scrollRightBtn) {
    scrollLeftBtn.addEventListener('click', () => {
      container.scrollBy({ left: -400, behavior: 'smooth' });
    });
    scrollRightBtn.addEventListener('click', () => {
      container.scrollBy({ left: 400, behavior: 'smooth' });
    });
  }
</script>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import VanillaTilt from 'vanilla-tilt';
  
  gsap.registerPlugin(ScrollTrigger);

  // Initialize smooth 3D tilt for project cards
  const projectCards = document.querySelectorAll('#portfolio .snap-center');
  VanillaTilt.init(Array.from(projectCards), {
    max: 10,
    speed: 500,
    glare: true,
    "max-glare": 0.15,
    perspective: 1200,
  });

  gsap.fromTo("#portfolio .snap-center", 
    {
      rotationX: -10,
      rotationY: 15,
      z: -100,
      y: 60,
      opacity: 0,
      filter: "blur(15px)",
    },
    {
      scrollTrigger: {
        trigger: "#portfolio-container",
        start: "top 85%",
        once: true,
      },
      rotationX: 0,
      rotationY: 0,
      z: 0,
      y: 0,
      opacity: 1,
      filter: "blur(0px)",
      duration: 1.6,
      stagger: 0.2,
      overwrite: 'auto',
      ease: "power4.out",
      clearProps: "all",
      onComplete: () => {
        document.querySelectorAll('#portfolio .snap-center').forEach((el) => {
          (el as HTMLElement).style.opacity = '1';
          (el as HTMLElement).style.filter = 'none';
        });
      }
    }
  );

  // Fallback to ensure visibility if ScrollTrigger misfires due to rapid reloads
  setTimeout(() => {
    document.querySelectorAll('#portfolio .snap-center').forEach((el) => {
      const htmlEl = el as HTMLElement;
      if (htmlEl.style.opacity === '0' || window.getComputedStyle(htmlEl).opacity === '0') {
        gsap.set(htmlEl, { clearProps: "all" });
        htmlEl.style.opacity = '1';
        htmlEl.style.filter = 'none';
      }
    });
  }, 2500);
</script>
