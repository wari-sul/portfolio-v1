---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<div class="max-w-[1200px] mx-auto p-6 md:my-20" id="portfolio">
  <div class="pb-8">
    <h2 class="text-4xl mb-4 font-bold text-gray-200">
      My <span class="primary-color-text">Portfolio</span>
    </h2>
    <p class="text-gray-400">Check out some of my recent work</p>
  </div>

  <div class="relative w-full group">
    <!-- Horizontal scroll container -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 hide-scrollbar" id="portfolio-container">
      {projects.map(project => (
        <div class="snap-center shrink-0 w-[85%] md:w-[60%] lg:w-[45%] rounded-xl bg-[#202121] border border-gray-800 overflow-hidden hover:border-[#c92085] transition-colors duration-300">
          <div class="aspect-video w-full overflow-hidden bg-black/50">
            {project.data.videoUrl ? (
              <iframe
                src={project.data.videoUrl}
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
                class="w-full h-full object-cover"
                title={project.data.title}
              ></iframe>
            ) : project.data.image ? (
              <Image
                src={project.data.image}
                alt={project.data.title}
                class="w-full h-full object-cover hover:scale-105 transition duration-500"
                loading="lazy"
                width={800}
                quality="mid"
              />
            ) : null}
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-200 mb-2">{project.data.title}</h3>
            <p class="text-gray-400 mb-6 min-h-[3rem]">{project.data.description}</p>
            <div class="flex justify-between items-center">
              {project.data.links.site && (
                <a href={project.data.links.site} target="_blank" rel="noopener noreferrer" class="bg-primary-color text-white px-6 py-2 rounded-lg font-bold hover:opacity-90 transition">
                  Live Demo
                </a>
              )}
              {project.data.links.github && (
                <a href={project.data.links.github} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition" aria-label="GitHub Repository">
                  <svg fill="currentColor" viewBox="0 0 24 24" class="w-8 h-8"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Optional Custom Scroll Indicators -->
    <div class="hidden md:flex justify-between absolute top-1/2 -translate-y-1/2 w-full px-2 pointer-events-none opacity-0 group-hover:opacity-100 transition duration-300 -mx-4">
      <button id="scroll-left" class="pointer-events-auto bg-black/70 text-white p-3 rounded-full hover:bg-black transition" aria-label="Scroll left">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <button id="scroll-right" class="pointer-events-auto bg-black/70 text-white p-3 rounded-full hover:bg-black transition" aria-label="Scroll right">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* Hide standard scrollbar for a cleaner look */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const container = document.getElementById('portfolio-container');
  const scrollLeftBtn = document.getElementById('scroll-left');
  const scrollRightBtn = document.getElementById('scroll-right');

  if (container && scrollLeftBtn && scrollRightBtn) {
    scrollLeftBtn.addEventListener('click', () => {
      container.scrollBy({ left: -400, behavior: 'smooth' });
    });
    scrollRightBtn.addEventListener('click', () => {
      container.scrollBy({ left: 400, behavior: 'smooth' });
    });
  }
</script>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  gsap.from("#portfolio .snap-center", {
    scrollTrigger: {
      trigger: "#portfolio-container",
      start: "top 85%",
    },
    x: 50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.2,
    ease: "power2.out"
  });
</script>
