---
import { siteConfig } from '../config/site';
const accessKey = import.meta.env.PUBLIC_STATICFORMS_KEY;
if (!accessKey) {
  console.warn('[Contact] PUBLIC_STATICFORMS_KEY is not set — form submissions will fail.');
}
---

<div class="max-w-[1200px] mx-auto p-6 md:my-20" id="contact">
  <div class="text-center mb-12">
    <h2 class="text-5xl md:text-6xl mb-4 font-bold font-display text-gray-200 tracking-tight">
      <span class="primary-color-text">Contact</span> Me
    </h2>
    <p class="text-gray-400 font-sans text-lg">Let's build something elite together</p>
  </div>

  <div class="max-w-[680px] mx-auto glass-card p-8 md:p-10 depth-md">
    <!-- Success State -->
    <div id="contact-success" class="hidden text-center py-12">
      <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-br from-[#9d2ba8] to-[#e8a023] flex items-center justify-center">
        <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-white font-display mb-2">Message Sent!</h3>
      <p class="text-gray-400 font-sans">Thanks for reaching out. I'll get back to you shortly.</p>
    </div>

    <!-- Error State -->
    <div id="contact-error" class="hidden mb-6 px-5 py-4 rounded-xl border border-red-500/30 bg-red-500/10 text-red-400 text-sm font-sans">
      Something went wrong. Please try again or email me directly at
      <a href={`mailto:${siteConfig.email}`} class="underline ml-1">{siteConfig.email}</a>.
    </div>

    <!-- Form -->
    <form id="contact-form">
      <!-- StaticForms required hidden fields -->
      {accessKey && <input type="hidden" name="apiKey" value={accessKey} />}
      <!-- replyTo is intentionally omitted: StaticForms will use the email field automatically -->

      <!-- Honeypot Spam Protection — must stay empty -->
      <input type="text" name="honeypot" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
        <!-- Name -->
        <div class="flex flex-col gap-2">
          <label for="contact-name" class="text-sm font-medium text-gray-300 font-sans">Full Name</label>
          <input
            id="contact-name"
            type="text"
            name="name"
            required
            placeholder="John Doe"
            class="contact-input bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 font-sans text-sm outline-none focus:border-[rgba(201,32,133,0.6)] focus:bg-white/8 transition-all duration-300"
          />
        </div>

        <!-- Email -->
        <div class="flex flex-col gap-2">
          <label for="contact-email" class="text-sm font-medium text-gray-300 font-sans">Email Address</label>
          <input
            id="contact-email"
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="contact-input bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 font-sans text-sm outline-none focus:border-[rgba(201,32,133,0.6)] focus:bg-white/8 transition-all duration-300"
          />
        </div>
      </div>

      <!-- Message -->
      <div class="flex flex-col gap-2 mb-7">
        <label for="contact-message" class="text-sm font-medium text-gray-300 font-sans">Message</label>
        <textarea
          id="contact-message"
          name="message"
          required
          rows="5"
          placeholder="Tell me about your project or just say hi..."
          class="contact-input bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 font-sans text-sm outline-none focus:border-[rgba(201,32,133,0.6)] focus:bg-white/8 transition-all duration-300 resize-none"
        ></textarea>
      </div>

      <!-- Submit -->
      <button
        id="contact-submit"
        type="submit"
        class="w-full relative overflow-hidden bg-primary-color text-white font-bold py-4 px-8 rounded-xl hover:opacity-90 transition-all duration-300 hover:scale-[1.01] shadow-lg tracking-wide text-sm font-sans depth-sm flex items-center justify-center gap-3"
      >
        <span id="submit-label">Send Message</span>
        <span id="submit-spinner" class="hidden">
          <svg class="animate-spin w-5 h-5" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
          </svg>
        </span>
      </button>
    </form>

    <!-- Direct contact fallback -->
    <p class="text-center text-gray-600 text-xs font-sans mt-6">
      Or reach me directly at
      <a href={`mailto:${siteConfig.email}`} class="text-gray-400 hover:text-white transition-colors underline">{siteConfig.email}</a>
    </p>
  </div>
</div>

<style>
  .contact-input:focus {
    box-shadow: 0 0 0 3px rgba(201, 32, 133, 0.15);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import VanillaTilt from 'vanilla-tilt';

  gsap.registerPlugin(ScrollTrigger);

  // Initialize smooth 3D tilt for contact card
  const contactCard = document.querySelectorAll('#contact .glass-card');
  VanillaTilt.init(Array.from(contactCard), {
    max: 6,
    speed: 700,
    glare: true,
    "max-glare": 0.1,
    perspective: 1200,
  });

  gsap.fromTo("#contact .text-center > *",
    {
      z: -80,
      rotationX: 15,
      y: 40,
      opacity: 0,
      filter: "blur(15px)",
    },
    {
      scrollTrigger: {
        trigger: "#contact",
        start: "top 80%",
        once: true,
      },
      z: 0,
      rotationX: 0,
      y: 0,
      opacity: 1,
      filter: "blur(0px)",
      duration: 1.5,
      stagger: 0.2,
      ease: "power4.out",
      immediateRender: false,
    }
  );

  gsap.fromTo("#contact .glass-card",
    {
      scale: 0.9,
      rotationX: -10,
      z: -100,
      y: 50,
      opacity: 0,
      filter: "blur(15px)",
    },
    {
      scrollTrigger: {
        trigger: "#contact .glass-card",
        start: "top 85%",
        once: true,
      },
      scale: 1,
      rotationX: 0,
      z: 0,
      y: 0,
      opacity: 1,
      filter: "blur(0px)",
      duration: 1.6,
      ease: "power4.out",
      immediateRender: false,
    }
  );

  // Form submission
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label');
  const submitSpinner = document.getElementById('submit-spinner');
  const successEl = document.getElementById('contact-success');
  const errorEl = document.getElementById('contact-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Basic client-side validation
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) {
      errorEl?.classList.remove('hidden');
      return;
    }

    // Show loading state
    submitLabel?.classList.add('hidden');
    submitSpinner?.classList.remove('hidden');
    if (submitBtn) submitBtn.disabled = true;
    errorEl?.classList.add('hidden');

    try {
      const data = new FormData(form);
      const response = await fetch('https://api.staticforms.dev/submit', {
        method: 'POST',
        body: data,
      });

      const result = await response.json();

      if (result.success) {
        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
        // Animate success state in
        gsap.from('#contact-success > *', {
          y: 20,
          opacity: 0,
          stagger: 0.15,
          duration: 0.8,
          ease: 'power3.out'
        });
      } else {
        throw new Error(result.message || 'Submission failed');
      }
    } catch (err) {
      errorEl?.classList.remove('hidden');
      submitLabel?.classList.remove('hidden');
      submitSpinner?.classList.add('hidden');
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
