---
import { siteConfig } from '../config/site';
---

<div class="max-w-[1200px] mx-auto p-6 md:my-20" id="contact">
  <div class="text-center mb-12">
    <h2 class="text-4xl mb-4 font-bold text-gray-200">
      <span class="primary-color-text">Contact</span> Me
    </h2>
    <p class="text-gray-400">Let's work together</p>
  </div>

  <div class="max-w-[600px] mx-auto glass p-8 text-center">
    <p class="text-gray-300 text-lg mb-6">
      I'm currently available for freelance work and new opportunities. If you have a project that you want to get started, think you need my help with something, or just fancy saying hey, then get in touch!
    </p>
    <a href={`mailto:${siteConfig.email}`} class="inline-block bg-primary-color text-white font-bold py-4 px-8 rounded-lg hover:opacity-90 transition transform hover:scale-105">
      Email Me: {siteConfig.email}
    </a>
  </div>
</div>
