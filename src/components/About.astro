---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';

const skillsGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = (await getCollection('projects')).filter(p => p.data.featured).sort((a, b) => a.data.order - b.data.order);
---

<section class="mt-24 max-w-[1200px] mx-auto px-4 md:px-6 py-12 md:py-16" id="about">
  <div class="mb-12">
    <div class="p-2">
      <div class="text-gray-300 my-3 text-center">
        <h3 class="text-4xl font-semibold mb-5">About <span class="primary-color-text">Me</span></h3>
        <p class="text-justify leading-7 w-11/12 md:w-3/4 mx-auto">
          {siteConfig.description}
        </p>
      </div>
    </div>

    <div class="flex mt-10 items-center gap-7 justify-center">
      <div class="bg-[#333333]/40 p-5 rounded-lg text-center">
        <h3 class="md:text-4xl text-2xl font-semibold text-white">{siteConfig.stats.projects}</h3>
        <p><span class="md:text-base text-xs">Projects</span></p>
      </div>
      <div class="bg-[#333333]/40 p-5 rounded-lg text-center">
        <h3 class="md:text-4xl text-2xl font-semibold text-white">{siteConfig.stats.experience}</h3>
        <p><span class="md:text-base text-xs">years experience</span></p>
      </div>
      <div class="bg-[#333333]/40 p-5 rounded-lg text-center">
        <h3 class="md:text-4xl text-2xl font-semibold text-white">{siteConfig.stats.clients}</h3>
        <p><span class="md:text-base text-xs">happy clients</span></p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
    <!-- Skills -->
    <div class="p-6 col-span-2 md:col-span-1">
      <h2 class="text-gray-200 text-3xl font-bold mb-6"><span class="primary-color-text">Skills</span></h2>
      <div class="space-y-2 accordion-group">
        {skillsGroups.map(group => (
          <details class="bg-gray-800/50 rounded-lg overflow-hidden group">
            <summary class="w-full p-4 text-left text-lg font-semibold text-gray-100 flex justify-between items-center cursor-pointer hover:bg-white/10 transition">
              {group.data.groupTitle}
              <span class="transform transition-transform duration-200 group-open:rotate-180">&#9660;</span>
            </summary>
            <div class="px-4 pb-4 mt-2">
              {group.data.skills.map(skill => (
                <div class="mb-2 last:mb-0">
                  <h4 class="font-medium text-gray-200">{skill.category}</h4>
                  <p class="text-sm text-gray-400 ml-2">{skill.items.join(', ')}</p>
                </div>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Experience -->
    <div class="p-6 col-span-2 md:col-span-1">
      <h2 class="text-gray-200 text-3xl font-bold mb-6"><span class="primary-color-text">Experience</span></h2>
      <div class="space-y-2 accordion-group">
        {experiences.map(exp => (
          <details class="bg-gray-800/50 rounded-lg overflow-hidden group">
            <summary class="w-full p-4 text-left text-lg font-semibold text-gray-100 flex justify-between items-center cursor-pointer hover:bg-white/10 transition">
              {exp.data.title}
              <span class="transform transition-transform duration-200 group-open:rotate-180">&#9660;</span>
            </summary>
            <div class="px-4 pb-4 mt-2 text-gray-300">
              <ul class="list-disc list-inside ml-2 mt-1 text-sm">
                {exp.data.description.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
              <i class="block mt-2 text-xs text-gray-400">Result: {exp.data.result}</i>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>

  <div class="mt-16 flex flex-col md:flex-row justify-center items-center gap-8 lg:gap-12">
    {featuredProjects.map(project => (
      <div class="relative group w-full md:max-w-[600px] mb-8 md:mb-0">
        <div class="w-full h-full absolute -inset-1 bg-gradient-to-r from-purple-100 to-orange-900 rounded-lg blur opacity-25 group-hover:opacity-100 transition duration-300"></div>
        <div class="relative w-full p-4 bg-white/10 backdrop-blur-lg rounded-lg">
          <img
            src={project.data.image}
            alt={project.data.title}
            class="rounded-lg w-full md:max-w-[360px] mx-auto hover:scale-105 transition-all duration-300"
            loading="lazy"
          />
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  gsap.from("#about .mb-12 h3, #about .mb-12 p", {
    scrollTrigger: {
      trigger: "#about",
      start: "top 80%",
    },
    y: 30,
    opacity: 0,
    duration: 1,
    stagger: 0.2,
    ease: "power3.out"
  });

  gsap.from("#about .bg-\\[\\#333333\\]\\/40", {
    scrollTrigger: {
      trigger: "#about .flex.mt-10",
      start: "top 85%",
    },
    scale: 0.8,
    opacity: 0,
    duration: 0.8,
    stagger: 0.2,
    ease: "back.out(1.5)"
  });

  gsap.from("#about .accordion-group", {
    scrollTrigger: {
      trigger: "#about .accordion-group",
      start: "top 80%",
    },
    y: 30,
    opacity: 0,
    duration: 1,
    stagger: 0.2,
    ease: "power2.out"
  });
</script>
