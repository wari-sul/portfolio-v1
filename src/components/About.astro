---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { fetchStats } from '../utils/fetchStats';

const skillsGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

const stats = await fetchStats();
---

<section class="mt-24 max-w-[1200px] mx-auto px-4 md:px-6 py-12 md:py-16" id="about">
  <div class="mb-16" id="about-intro">
    <!-- Premium About Me intro card -->
    <div class="relative max-w-3xl mx-auto">
      <!-- Ambient glow behind card -->
      <div class="absolute -inset-px rounded-2xl bg-gradient-to-br from-[#9d2ba8]/30 via-[#e53e9a]/20 to-[#e8a023]/30 blur-xl opacity-60 animate-pulse"></div>
      
      <!-- Glass card -->
      <div class="relative glass-card p-8 md:p-12 overflow-hidden about-intro-card">
        <!-- Animated left accent bar -->
        <div class="absolute left-0 top-8 bottom-8 w-[3px] rounded-full bg-gradient-to-b from-[#9d2ba8] via-[#e53e9a] to-[#e8a023] about-accent-bar"></div>

        <!-- Subtle grid texture overlay -->
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 40px 40px;"></div>

        <!-- Corner decorative glow -->
        <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-bl from-[#e53e9a]/10 to-transparent rounded-tr-2xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-gradient-to-tr from-[#9d2ba8]/10 to-transparent rounded-bl-2xl pointer-events-none"></div>

        <div class="relative z-10 pl-6">
          <!-- Section label -->
          <div class="flex items-center gap-3 mb-6 about-reveal">
            <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase text-[#e53e9a] font-sans">
              <span class="w-4 h-px bg-[#e53e9a]"></span>
              About Me
            </span>
          </div>

          <!-- Hook — large, impactful -->
          <p class="text-2xl md:text-3xl lg:text-4xl font-extrabold font-display text-white leading-tight mb-8 about-reveal" style="text-wrap: balance;">
            {siteConfig.aboutMe.hook.split(' ').slice(0, 1).join(' ')}<span class="primary-color-text"> {siteConfig.aboutMe.hook.split(' ').slice(1).join(' ')}</span>
          </p>

          <!-- Divider -->
          <div class="w-12 h-px bg-gradient-to-r from-[#e53e9a] to-transparent mb-8 about-reveal"></div>

          <!-- Body text — broken into readable flow -->
          <div class="space-y-4 about-reveal">
            {siteConfig.aboutMe.body.split('. ').reduce((acc: string[][], sentence: string, i: number) => {
              const group = Math.floor(i / 3);
              if (!acc[group]) acc[group] = [];
              acc[group].push(sentence);
              return acc;
            }, []).map((sentences: string[]) => (
              <p class="text-base md:text-lg text-gray-400 font-sans leading-relaxed">
                {sentences.join('. ')}{sentences.length > 0 && !sentences[sentences.length - 1].endsWith('.') ? '.' : ''}
              </p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mt-10">
    <!-- Skills Bento Box -->
    <div class="p-4 md:p-6 col-span-2 md:col-span-1">
      <h2 class="text-gray-200 text-3xl font-bold mb-6"><span class="primary-color-text">Skills</span></h2>
      <div class="grid grid-cols-1 gap-4 accordion-group">
        {skillsGroups.map(group => (
          <div class="glass-card tracking-card p-5 group hover:border-[rgba(201,32,133,0.4)] transition-all duration-300 overflow-hidden">
            <div class="tracking-glow absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <h3 class="text-xl font-bold text-gray-100 mb-4 flex items-center gap-2 depth-md">
              <span class="w-2 h-2 rounded-full bg-gradient-to-r from-[#9d2ba8] to-[#e8a023]"></span>
              {group.data.groupTitle}
            </h3>
            <div class="space-y-4 depth-sm">
              {group.data.skills.map(skill => (
                <div>
                  <h4 class="font-medium text-gray-300 text-sm mb-2">{skill.category}</h4>
                  <div class="flex flex-wrap gap-2">
                    {skill.items.map(item => (
                      <span class="px-3 py-1 text-xs bg-white/5 border border-white/10 rounded-full text-gray-300 hover:bg-white/10 hover:border-white/20 transition-colors">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Experience Cards -->
    <div class="p-4 md:p-6 col-span-2 md:col-span-1">
      <h2 class="text-gray-200 text-3xl font-bold mb-6"><span class="primary-color-text">Experience</span></h2>
      <div class="space-y-4 accordion-group">
        {experiences.map(exp => (
          <div class="glass-card tracking-card p-6 group hover:border-[rgba(201,32,133,0.4)] transition-all duration-300 relative overflow-hidden">
            <div class="tracking-glow absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#c92085] to-transparent opacity-0 group-hover:opacity-10 transition-opacity duration-500 rounded-bl-full pointer-events-none"></div>
            <h3 class="text-xl font-bold text-gray-100 mb-1 depth-md">{exp.data.title}</h3>
            <ul class="list-disc list-outside ml-4 mt-3 text-sm text-gray-300 space-y-1.5 depth-sm">
              {exp.data.description.map(item => (
                <li>{item}</li>
              ))}
            </ul>
            {exp.data.result && (
              <div class="mt-4 pt-3 border-t border-white/10 flex items-start gap-2">
                <span class="text-[#e8a023] text-sm mt-0.5">✦</span>
                <i class="block text-sm text-gray-400">{exp.data.result}</i>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>


</section>



<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import VanillaTilt from 'vanilla-tilt';
  
  gsap.registerPlugin(ScrollTrigger);

  // ─── About Me intro card animation ───────────────────────────────────────
  // Animate the whole card in from below
  gsap.from(".about-intro-card", {
    scrollTrigger: {
      trigger: "#about-intro",
      start: "top 85%",
      once: true,
    },
    y: 60,
    opacity: 0,
    scale: 0.97,
    filter: "blur(8px)",
    duration: 1.4,
    ease: "power4.out",
  });

  // Stagger the internal reveal elements
  gsap.from(".about-reveal", {
    scrollTrigger: {
      trigger: "#about-intro",
      start: "top 80%",
      once: true,
    },
    y: 30,
    opacity: 0,
    duration: 1.0,
    stagger: 0.15,
    ease: "power3.out",
    delay: 0.3,
  });

  // Accent bar grows from top
  gsap.from(".about-accent-bar", {
    scrollTrigger: {
      trigger: "#about-intro",
      start: "top 80%",
      once: true,
    },
    scaleY: 0,
    transformOrigin: "top center",
    duration: 1.2,
    ease: "power4.out",
    delay: 0.2,
  });

  // Initialize smooth 3D tilt — exclude the intro card to avoid fighting ambient glow
  const skillCards = document.querySelectorAll('#about .glass-card:not(.about-intro-card)');
  if (skillCards.length > 0) {
    VanillaTilt.init(Array.from(skillCards), {
      max: 12,
      speed: 600,
      glare: true,
      "max-glare": 0.15,
      perspective: 1000,
      scale: 1.02,
      gyroscope: true,
    });
  }

  // 3D fold-in animation for skill/experience bento cards individually
  gsap.utils.toArray("#about .glass-card:not(.about-intro-card)").forEach((card: any) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: "top 90%",
        once: true,
      },
      rotationX: -10,
      rotationY: 8,
      z: -100,
      y: 50,
      opacity: 0,
      duration: 1.2,
      ease: "power4.out",
      onComplete: () => {
        card.style.opacity = '1';
      },
    });
  });

  // Mouse tracking glow effect
  const trackingCards = document.querySelectorAll('.tracking-card');
  trackingCards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e as MouseEvent).clientX - rect.left;
      const y = (e as MouseEvent).clientY - rect.top;
      (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
    });
  });
</script>
