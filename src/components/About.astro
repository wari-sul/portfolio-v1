---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { Image } from 'astro:assets';
import { fetchStats } from '../utils/fetchStats';

const skillsGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = (await getCollection('projects')).filter(p => p.data.featured).sort((a, b) => a.data.order - b.data.order);

const stats = await fetchStats();
---

<section class="mt-24 max-w-[1200px] mx-auto px-4 md:px-6 py-12 md:py-16" id="about">
  <div class="mb-12">
    <div class="p-2">
      <div class="text-gray-300 my-3 text-center">
        <h3 class="text-5xl md:text-6xl font-bold tracking-tight font-display mb-6">About <span class="primary-color-text">Me</span></h3>
        <p class="text-justify leading-8 text-lg w-11/12 md:w-3/4 mx-auto font-sans">
          {siteConfig.description}
        </p>
      </div>
    </div>

    <div class="flex mt-10 items-center gap-7 justify-center">
      <div class="bg-[#333333]/40 p-5 rounded-lg text-center">
        <h3 class="md:text-4xl text-2xl font-semibold text-white">{stats.projects}</h3>
        <p><span class="md:text-base text-xs">Projects</span></p>
      </div>
      <div class="bg-[#333333]/40 p-5 rounded-lg text-center">
        <h3 class="md:text-4xl text-2xl font-semibold text-white">{stats.experience}</h3>
        <p><span class="md:text-base text-xs">years experience</span></p>
      </div>
      <div class="bg-[#333333]/40 p-5 rounded-lg text-center">
        <h3 class="md:text-4xl text-2xl font-semibold text-white">{stats.clients}</h3>
        <p><span class="md:text-base text-xs">happy clients</span></p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mt-10">
    <!-- Skills Bento Box -->
    <div class="p-4 md:p-6 col-span-2 md:col-span-1">
      <h2 class="text-gray-200 text-3xl font-bold mb-6"><span class="primary-color-text">Skills</span></h2>
      <div class="grid grid-cols-1 gap-4 accordion-group">
        {skillsGroups.map(group => (
          <div class="glass-card tracking-card p-5 group hover:border-[rgba(201,32,133,0.4)] transition-all duration-300 overflow-hidden">
            <div class="tracking-glow absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <h3 class="text-xl font-bold text-gray-100 mb-4 flex items-center gap-2 depth-md">
              <span class="w-2 h-2 rounded-full bg-gradient-to-r from-[#9d2ba8] to-[#e8a023]"></span>
              {group.data.groupTitle}
            </h3>
            <div class="space-y-4 depth-sm">
              {group.data.skills.map(skill => (
                <div>
                  <h4 class="font-medium text-gray-300 text-sm mb-2">{skill.category}</h4>
                  <div class="flex flex-wrap gap-2">
                    {skill.items.map(item => (
                      <span class="px-3 py-1 text-xs bg-white/5 border border-white/10 rounded-full text-gray-300 hover:bg-white/10 hover:border-white/20 transition-colors">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Experience Cards -->
    <div class="p-4 md:p-6 col-span-2 md:col-span-1">
      <h2 class="text-gray-200 text-3xl font-bold mb-6"><span class="primary-color-text">Experience</span></h2>
      <div class="space-y-4 accordion-group">
        {experiences.map(exp => (
          <div class="glass-card tracking-card p-6 group hover:border-[rgba(201,32,133,0.4)] transition-all duration-300 relative overflow-hidden">
            <div class="tracking-glow absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#c92085] to-transparent opacity-0 group-hover:opacity-10 transition-opacity duration-500 rounded-bl-full pointer-events-none"></div>
            <h3 class="text-xl font-bold text-gray-100 mb-1 depth-md">{exp.data.title}</h3>
            <ul class="list-disc list-outside ml-4 mt-3 text-sm text-gray-300 space-y-1.5 depth-sm">
              {exp.data.description.map(item => (
                <li>{item}</li>
              ))}
            </ul>
            {exp.data.result && (
              <div class="mt-4 pt-3 border-t border-white/10 flex items-start gap-2">
                <span class="text-[#e8a023] text-sm mt-0.5">✦</span>
                <i class="block text-sm text-gray-400">{exp.data.result}</i>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="mt-16 flex flex-col md:flex-row justify-center items-center gap-8 lg:gap-12">
    {featuredProjects.map(project => (
      <div class="relative group w-full md:max-w-[600px] mb-8 md:mb-0">
        <div class="w-full h-full absolute -inset-1 bg-gradient-to-r from-purple-100 to-orange-900 rounded-lg blur opacity-25 group-hover:opacity-100 transition duration-300"></div>
        <div class="relative w-full p-4 bg-white/10 backdrop-blur-lg rounded-lg">
          {project.data.image && (
            <Image
              src={project.data.image}
              alt={project.data.title}
              class="rounded-lg w-full md:max-w-[360px] mx-auto hover:scale-105 transition-all duration-300"
              loading="lazy"
              width={600}
              quality="mid"
            />
          )}
        </div>
      </div>
    ))}
  </div>
</section>



<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import VanillaTilt from 'vanilla-tilt';
  
  gsap.registerPlugin(ScrollTrigger);

  // Initialize smooth 3D tilt
  const cards = document.querySelectorAll('.glass-card');
  VanillaTilt.init(Array.from(cards), {
    max: 12,
    speed: 600,
    glare: true,
    "max-glare": 0.15,
    perspective: 1000,
    scale: 1.02,
    gyroscope: true,
  });

  // Expensive 3D GSAP Scroll animation
  gsap.from("#about .mb-12 h3, #about .mb-12 p", {
    scrollTrigger: {
      trigger: "#about",
      start: "top 80%",
    },
    z: -80,
    rotationX: 25,
    y: 50,
    opacity: 0,
    filter: "blur(15px)",
    duration: 1.6,
    stagger: 0.2,
    ease: "power4.out"
  });

  gsap.from("#about .bg-\\[\\#333333\\]\\/40", {
    scrollTrigger: {
      trigger: "#about .flex.mt-10",
      start: "top 85%",
    },
    scale: 0.8,
    z: -50,
    rotationY: 15,
    y: 30,
    opacity: 0,
    filter: "blur(10px)",
    duration: 1.4,
    stagger: 0.15,
    ease: "power3.out"
  });

  // 3D fold-in animation for bento boxes
  gsap.from("#about .glass-card", {
    scrollTrigger: {
      trigger: "#about .grid.grid-cols-1",
      start: "top 80%",
    },
    rotationX: -15,
    rotationY: 10,
    z: -150,
    y: 60,
    opacity: 0,
    duration: 1.5,
    stagger: 0.15,
    ease: "power4.out"
  });

  // Mouse tracking glow effect
  const trackingCards = document.querySelectorAll('.tracking-card');
  trackingCards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e as MouseEvent).clientX - rect.left;
      const y = (e as MouseEvent).clientY - rect.top;
      (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
    });
  });
</script>
